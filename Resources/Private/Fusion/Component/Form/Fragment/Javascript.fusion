prototype(Garagist.Mautic:Component.Form.Fragment.Javascript) < prototype(Neos.Fusion:Component) {
    @if.hasUrlAndId = ${this.mauticForm.url && this.mauticForm.id}

    renderer = afx`
        <script
            type="text/javascript"
            src={props.mauticForm.url + "/form/generate.js?id=" + props.mauticForm.id}
            defer
        ></script>
    `
}
