prototype(Garagist.Mautic:Component.Form.Fragment.Iframe) < prototype(Neos.Fusion:Component) {
    @propTypes {
        class = ${PropTypes.anyOf( PropTypes.string, PropTypes.arrayOf( PropTypes.string ) )}
    }

    class = ${this.iframeClass}

    @if.hasUrlAndId = ${this.mauticForm.url && this.mauticForm.id}

    renderer = afx`
        <iframe src={props.mauticForm.url + "/form/" + props.mauticForm.id} class={props.class}></iframe>
    `
}
