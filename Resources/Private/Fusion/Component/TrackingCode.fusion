prototype(Garagist.Mautic:Component.TrackingCode) < prototype(Neos.Fusion:Component) {
    @propTypes {
        url= ${PropTypes.string}
    }

    node = ${site}
    url = ${q(this.node).property('mauticTrackingUrl')}

    @if.setTrackingCode = ${this.url && !node.context.inBackend}

    renderer = Neos.Fusion:Tag {
        tagName = 'script'
        content = ${"(function(w,d,t,u,n,a,m){w['MauticTrackingObject']=n;w[n]=w[n]||function(){(w[n].q=w[n].q||[]).push(arguments)},a=d.createElement(t),m=d.getElementsByTagName(t)[0];a.async=1;a.src=u;m.parentNode.insertBefore(a,m)})(window,document,'script','" + props.url + "/mtc.js','mt');mt('send', 'pageview');"}
    }

    @context.cacheNode = ${this.node}
    @cache {
        mode = 'cached'
        maximumLifetime = ${q(cacheNode).context({'invisibleContentShown': true}).cacheLifetime()}
        entryIdentifier {
            node = ${cacheNode}
            cacheEntryIdentifier = 'mauticTrackingCode'
        }
        entryTags {
            1 = ${Neos.Caching.nodeTag(cacheNode)}
        }
    }
}
